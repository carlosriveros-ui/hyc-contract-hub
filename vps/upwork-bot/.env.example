# Upwork Bot — HYC Proyectos de Ingeniería SAS
# Copia este archivo como .env y completa los valores

# Credenciales Upwork
UPWORK_EMAIL=tu-email@gmail.com
UPWORK_PASSWORD=tu-contraseña

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-xxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Anthropic / Claude AI
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuracion de filtros (opcional, estos son los valores por defecto)
CHECK_INTERVAL_MINUTES=30
MIN_CLIENT_RATING=4.4
MAX_APPLICANTS=15
MIN_SCORE=12

# Ruta del archivo de cookies (no cambiar normalmente)
COOKIES_PATH=cookies.json

# Hermes Agent (VPS) — para consultas interactivas por Telegram
# Pon la IP publica de tu VPS (la misma de Hostinger)
HERMES_API_URL=http://TU_IP_VPS:3000
# Si configuraste AGENT_API_KEY en el VPS, ponla aqui. Si no, dejala vacia.
HERMES_API_KEY=
