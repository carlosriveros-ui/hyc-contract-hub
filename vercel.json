{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-content",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/agenda-reminders",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/agenda.ts": {
      "includeFiles": "videos/marcas.json"
    },
    "api/cron/agenda-reminders.ts": {
      "includeFiles": "videos/marcas.json"
    }
  }
}
